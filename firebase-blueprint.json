{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A viral remake project created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "originalLink": { "type": "string" },
        "originalAnalysis": {
          "type": "object",
          "properties": {
            "hook": { "type": "string" },
            "structure": { "type": "string" },
            "tempo": { "type": "string" },
            "cta": { "type": "string" },
            "viralPoints": { "type": "array", "items": { "type": "string" } }
          }
        },
        "remakeOutput": {
          "type": "object",
          "properties": {
            "narration": { "type": "string" },
            "shootingAngles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "editFormat": { "type": "string" },
            "viralScore": { "type": "integer" },
            "tips": { "type": "array", "items": { "type": "string" } }
          }
        },
        "brandImage": { "type": "string" },
        "userPhoto": { "type": "string" },
        "createdAt": { "type": "integer" },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "originalLink", "userId", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Basic information about the user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Viral remake projects"
    },
    "/projects/{projectId}/scenes/{sceneId}": {
      "schema": {
        "type": "object",
        "properties": {
          "imageUrl": { "type": "string" }
        }
      },
      "description": "Large images for scenario scenes"
    },
    "/projects/{projectId}/frames/{frameId}": {
      "schema": {
        "type": "object",
        "properties": {
          "screenshotUrl": { "type": "string" }
        }
      },
      "description": "Large screenshots for key timestamps"
    }
  }
}
