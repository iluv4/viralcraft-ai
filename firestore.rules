rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.keys().size() == 5
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.createdAt == request.time;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'originalLink', 'userId', 'createdAt'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.originalLink is string && data.originalLink.size() <= 2048
        && data.createdAt is timestamp
        && (data.keys().size() >= 5 && data.keys().size() <= 15); // Allow optional analysis/remake fields
    }

    // Routes
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) 
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().id == projectId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time; // Enforce server time on create

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidProject(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          // Action: Update Analysis
          incoming().diff(existing()).affectedKeys().hasOnly(['originalAnalysis']) ||
          // Action: Generate Remake
          incoming().diff(existing()).affectedKeys().hasOnly(['remakeOutput']) ||
          // Action: Settings
          incoming().diff(existing()).affectedKeys().hasOnly(['title'])
        );

      allow delete: if isOwner(existing().userId);

      // Sub-collections for large assets
      match /scenes/{sceneId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
        allow write: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }

      match /frames/{frameId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
        allow write: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
    }
  }
}
